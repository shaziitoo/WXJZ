.form-item {
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--line-2);
}

.form-item:first-child {
  padding-top: 0;
}

.form-item-last {
  border-bottom: none;
  padding-bottom: 0;
}

.form-label {
  font-size: 26rpx;
  color: var(--text-2);
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
}

.required {
  color: var(--expense);
  margin-right: 6rpx;
}

.form-input {
  width: 100%;
  font-size: 30rpx;
  color: var(--text);
  height: 48rpx;
  line-height: 48rpx;
}

.form-placeholder {
  color: var(--text-3);
  font-size: 30rpx;
}

.form-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 48rpx;
  font-size: 30rpx;
  color: var(--text);
}

.placeholder {
  color: var(--text-3);
}

.arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 3rpx solid var(--text-3);
  border-right: 3rpx solid var(--text-3);
  transform: rotate(45deg);
  margin-right: 6rpx;
}

.form-textarea {
  width: 100%;
  font-size: 30rpx;
  color: var(--text);
  min-height: 120rpx;
  line-height: 1.6;
}

/* ---------- 完工日期（含暂定开关） ---------- */
.enddate-line {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.enddate-line picker {
  flex: 1;
  min-width: 0;
}

.chip-sm {
  flex-shrink: 0;
  height: 56rpx;
  line-height: 52rpx;
  padding: 0 26rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
}

/* ---------- 状态选择 ---------- */
.chip-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  padding: 0 32rpx;
  height: 68rpx;
  line-height: 64rpx;
  border-radius: 34rpx;
  font-size: 26rpx;
  color: var(--text-2);
  background: var(--line-2);
  border: 2rpx solid transparent;
}

.chip-active {
  background: var(--primary-light);
  color: var(--primary);
  border-color: var(--primary-2);
  font-weight: 500;
}

.tip {
  margin-top: 24rpx;
  padding: 0 8rpx;
  font-size: 24rpx;
  color: var(--text-3);
  line-height: 1.7;
}
