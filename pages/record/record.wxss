/* ---------- 收支切换 ---------- */
.type-switch {
  display: flex;
  background: var(--card);
  border-radius: var(--radius-sm);
  padding: 6rpx;
  margin-bottom: 24rpx;
}

.ts-item {
  flex: 1;
  text-align: center;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 30rpx;
  color: var(--text-2);
  border-radius: 8rpx;
  transition: all 0.18s;
}

.ts-item-expense {
  background: var(--expense-light);
  color: var(--expense);
  font-weight: 500;
}

.ts-item-income {
  background: var(--income-light);
  color: var(--income-2);
  font-weight: 500;
}

/* ---------- 金额 ---------- */
.amount-card {
  padding: 32rpx 28rpx;
}

.amount-label {
  font-size: 24rpx;
  color: var(--text-3);
}

.amount-row {
  display: flex;
  align-items: baseline;
  margin-top: 12rpx;
}

.amount-symbol {
  font-size: 44rpx;
  font-weight: 500;
  margin-right: 12rpx;
}

.amount-input {
  flex: 1;
  min-width: 0;
  font-size: 68rpx;
  font-weight: 500;
  height: 96rpx;
  line-height: 96rpx;
  color: var(--text);
}

.amount-placeholder {
  font-size: 68rpx;
  color: var(--line);
}

/* ---------- 行式表单 ---------- */
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 56rpx;
}

.row-label {
  font-size: 28rpx;
  color: var(--text-2);
  flex-shrink: 0;
  width: 120rpx;
}

.row-value {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  color: var(--text);
}

.row-weekday {
  font-size: 24rpx;
  color: var(--text-3);
  margin-left: 16rpx;
}

.row-input {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: 30rpx;
  color: var(--text);
  height: 56rpx;
}

.form-placeholder {
  color: var(--text-3);
  font-size: 30rpx;
}

.arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 3rpx solid var(--text-3);
  border-right: 3rpx solid var(--text-3);
  transform: rotate(45deg);
  margin-left: 16rpx;
  margin-right: 4rpx;
}

/* ---------- 类别网格 ---------- */
.cat-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 24rpx;
  color: var(--text-3);
  margin-bottom: 20rpx;
}

.cat-manage {
  color: var(--primary);
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  background: var(--primary-light);
  border-radius: 8rpx;
}

.cat-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.cat-cell {
  width: calc(25% - 12rpx);
  height: 100rpx;
  border-radius: var(--radius-sm);
  background: var(--line-2);
  border: 2rpx solid transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
}

.cat-cell-active {
  color: #fff;
}

.cat-cell-text {
  font-size: 24rpx;
  text-align: center;
  line-height: 1.3;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  word-break: break-all;
}

.cat-cell-add {
  background: var(--card);
  border: 2rpx dashed var(--line);
  flex-direction: column;
  gap: 0;
}

.cat-cell-add-icon {
  font-size: 32rpx;
  color: var(--text-3);
  line-height: 1;
}

.cat-cell-add .cat-cell-text {
  color: var(--text-3);
  font-size: 22rpx;
  margin-top: 4rpx;
}

.form-tip {
  margin-top: 24rpx;
  padding: 0 8rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

/* ---------- 大屏适配 ---------- */
@media (min-width: 640px) {
  .cat-cell {
    width: calc(16.66% - 14rpx);
  }
}
