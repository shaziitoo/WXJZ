page {
  /* 颜色体系 */
  --bg: #f4f5f7;
  --card: #ffffff;
  --text: #1a1a1a;
  --text-2: #6b7280;
  --text-3: #9ca3af;
  --line: #ebedf0;
  --line-2: #f2f3f5;
  --primary: #185fa5;
  --primary-2: #378add;
  --primary-light: #e6f1fb;
  --expense: #e24b4a;
  --expense-light: #fcebeb;
  --income: #3b6d11;
  --income-2: #639922;
  --income-light: #eaf3de;
  --warning: #ba7517;
  --warning-light: #faeeda;

  --radius: 16rpx;
  --radius-sm: 10rpx;
  --gap: 24rpx;

  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

view,
text,
input,
textarea,
picker,
button {
  box-sizing: border-box;
}

/* ---------- 通用布局 ---------- */
.page {
  min-height: 100vh;
  padding: var(--gap) var(--gap) 200rpx;
}

.flex {
  display: flex;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-1 {
  flex: 1;
  min-width: 0;
}

.col {
  display: flex;
  flex-direction: column;
}

.mt-sm { margin-top: 16rpx; }
.mt { margin-top: 24rpx; }
.mt-lg { margin-top: 40rpx; }
.mb-sm { margin-bottom: 16rpx; }

/* ---------- 卡片 ---------- */
.card {
  background: var(--card);
  border-radius: var(--radius);
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(16, 24, 40, 0.04);
}

.card + .card {
  margin-top: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text);
  margin-bottom: 8rpx;
}

.card-sub {
  font-size: 24rpx;
  color: var(--text-3);
}

/* ---------- 文字 ---------- */
.t-primary { color: var(--text); }
.t-secondary { color: var(--text-2); }
.t-tertiary { color: var(--text-3); }

.text-ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.money-expense { color: var(--expense); }
.money-income { color: var(--income-2); }

.num {
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
}

/* ---------- 标签 ---------- */
.tag {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  line-height: 40rpx;
}

.tag-expense {
  background: var(--expense-light);
  color: var(--expense);
}

.tag-income {
  background: var(--income-light);
  color: var(--income-2);
}

.tag-gray {
  background: var(--line-2);
  color: var(--text-2);
}

.tag-primary {
  background: var(--primary-light);
  color: var(--primary);
}

/* ---------- 按钮 ---------- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: var(--radius);
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  line-height: 1;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: var(--primary);
  color: #fff;
}

.btn-primary.btn-hover {
  background: #12497f;
}

.btn-ghost {
  background: var(--card);
  color: var(--text-2);
  border: 2rpx solid var(--line);
}

.btn-danger {
  background: var(--card);
  color: var(--expense);
  border: 2rpx solid #f7c1c1;
}

.btn-block {
  width: 100%;
}

.btn-sm {
  height: 64rpx;
  font-size: 26rpx;
  padding: 0 28rpx;
  border-radius: var(--radius-sm);
}

/* ---------- 空状态 ---------- */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--line-2);
  margin-bottom: 28rpx;
  position: relative;
}

.empty-icon::before,
.empty-icon::after {
  content: "";
  position: absolute;
  background: #fff;
  border-radius: 4rpx;
}

.empty-icon::before {
  width: 76rpx;
  height: 10rpx;
  left: 42rpx;
  top: 56rpx;
}

.empty-icon::after {
  width: 76rpx;
  height: 10rpx;
  left: 42rpx;
  top: 92rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-3);
}

.empty-tip {
  font-size: 24rpx;
  color: var(--text-3);
  margin-top: 12rpx;
}

/* ---------- 表单占位符（多页面共用） ---------- */
.form-placeholder {
  color: var(--text-3);
  font-size: 30rpx;
}

/* ---------- 悬浮底部操作条 ---------- */
.footer-bar > .btn {
  flex: 1;
  min-width: 0;
}

.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx var(--gap) calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.94);
  border-top: 2rpx solid var(--line);
  display: flex;
  gap: 20rpx;
  z-index: 20;
}

/* ---------- 大屏适配：宽屏设备内容居中 ---------- */
@media (min-width: 768px) {
  .page {
    max-width: 900px;
    margin: 0 auto;
  }

  .footer-bar > .btn {
    max-width: 900px;
    margin: 0 auto;
  }
}

/* ===================================================================
   大字版（全局）：在「首页 / 详情 / 记一笔 / 工程表单 / 类别管理」统一放大文字
   触发：根容器 .page / .footer-bar / .modal-mask 带 .lt 类（由 largeText 控制）
   =================================================================== */
.lt {
  font-size: 36rpx;
}

/* 通用卡片标题 / 副标题 / 空状态 */
.lt .card-title { font-size: 38rpx; }
.lt .card-sub { font-size: 30rpx; }
.lt .empty-text { font-size: 32rpx; }
.lt .empty-tip { font-size: 26rpx; }

/* 行式表单（日期、类别、备注等） */
.lt .row-label,
.lt .row-value,
.lt .row-input { font-size: 34rpx; }

/* 占位符 */
.lt .form-placeholder,
.lt .placeholder { font-size: 34rpx; }

/* 标签 */
.lt .tag { font-size: 24rpx; }

/* 按钮（含底部操作条） */
.lt .btn {
  height: 100rpx;
  font-size: 34rpx;
  line-height: 1;
}

/* ---- 首页 ---- */
.lt .hero-label,
.lt .hero-item-label { font-size: 28rpx; }
.lt .hero-balance { font-size: 76rpx; }
.lt .hero-item-value { font-size: 40rpx; }
.lt .segment-item { font-size: 32rpx; height: 80rpx; line-height: 80rpx; }
.lt .pc-title { font-size: 42rpx; }
.lt .pc-meta { font-size: 30rpx; }
.lt .pc-fig-label { font-size: 26rpx; }
.lt .pc-fig-value { font-size: 38rpx; }

/* ---- 工程详情 ---- */
.lt .dh-name { font-size: 42rpx; }
.lt .dh-meta { font-size: 28rpx; }
.lt .dh-fig-label { font-size: 26rpx; }
.lt .dh-fig-value { font-size: 38rpx; }
.lt .dh-fig-main .dh-fig-value { font-size: 54rpx; }
.lt .modal-title { font-size: 36rpx; }
.lt .ex-label { font-size: 30rpx; }
.lt .seg-item { font-size: 30rpx; }
.lt .ex-picker { font-size: 30rpx; }
.lt .chip { font-size: 30rpx; }

/* ---- 工程表单 ---- */
.lt .form-label { font-size: 32rpx; }
.lt .form-input,
.lt .form-picker,
.lt .form-textarea { font-size: 34rpx; line-height: 1.5; }
.lt .chip-sm { font-size: 26rpx; }
.lt .tip { font-size: 28rpx; }

/* ---- 类别管理 ---- */
.lt .cat-reset { font-size: 26rpx; }
.lt .cat-name { font-size: 34rpx; }
.lt .cat-action { font-size: 28rpx; }
.lt .add-input { font-size: 32rpx; }

/* ---- 记一笔 ---- */
.lt .amount-label { font-size: 28rpx; }
.lt .amount-symbol { font-size: 52rpx; }
.lt .cat-title { font-size: 28rpx; }
.lt .cat-cell-text { font-size: 28rpx; }
